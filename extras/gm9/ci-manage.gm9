# custom-install snapshot export and import.
# Boot GodMode9 with START, then HOME -> Scripts -> ci-manage.
# Do not open HOME Menu between export and import.

set ERRORMSG "ci-manage failed"
set PREVIEW_MODE "Export or import the title-management snapshot."

set HMSAVE 00020082
set EXTID 00000082
if chk $[REGION] "USA"
	set HMSAVE 0002008f
	set EXTID 0000008f
elif chk $[REGION] "EUR"
	set HMSAVE 00020098
	set EXTID 00000098
elif chk $[REGION] "CHN"
	set HMSAVE 000200a1
	set EXTID 000000a1
elif chk $[REGION] "KOR"
	set HMSAVE 000200a9
	set EXTID 000000a9
elif chk $[REGION] "TWN"
	set HMSAVE 000200b1
	set EXTID 000000b1
elif chk $[REGION] "JPN"
	set HMSAVE 00020082
	set EXTID 00000082
else
	echo "Region $[REGION] is not JPN, USA, EUR, CHN, KOR, or TWN."
	ask "Abort?"
end

@Menu
set ERRORMSG "ci-manage cancelled"
labelsel -s "ci-manage" Menu_*
goto Menu

@Menu_Export
set OUT $[GM9OUT]/ci-manage/$[DATESTAMP]-$[TIMESTAMP]
mkdir $[GM9OUT]/ci-manage
mkdir $[OUT]
mkdir $[OUT]/nand
mkdir $[OUT]/sd
mkdir $[OUT]/plain
echo "Exporting to\n$[OUT]"
set ERRORMSG "movable.sed copy failed"
cp -w 1:/private/movable.sed $[OUT]/nand/movable.sed
set ERRORMSG "boot9.bin copy failed"
cp -w M:/boot9.bin $[OUT]/nand/boot9.bin
set ERRORMSG "otp copy failed"
if find M:/otp.bin OTPSRC
	cp -w $[OTPSRC] $[OUT]/nand/otp.bin
elif find M:/otp.mem OTPSRC
	cp -w $[OTPSRC] $[OUT]/nand/otp.bin
else
	echo "otp.bin and otp.mem were not found on M:."
	ask "Abort?"
end
set ERRORMSG "ticket.db copy failed"
cp -w 1:/dbs/ticket.db $[OUT]/nand/ticket.db
set ERRORMSG "HOME Menu save copy failed"
cp -w 1:/data/$[SYSID0]/sysdata/$[HMSAVE]/00000000 $[OUT]/nand/homemenu-save.bin
set ERRORMSG "seed save copy failed"
cp -w 1:/data/$[SYSID0]/sysdata/0001000f/00000000 $[OUT]/nand/seed-save.bin
imgmount -s -o $[OUT]/nand/homemenu-save.bin
cp -s -o G:/Launcher.dat $[OUT]/plain/Launcher.dat
imgumount -s -o
imgmount -s -o $[OUT]/nand/seed-save.bin
cp -s -o G:/SEEDDB $[OUT]/plain/SEEDDB
imgumount -s -o
set ERRORMSG "SD id1 directory was not found"
find "0:/Nintendo 3DS/$[SYSID0]/*" ID1DIR
set ERRORMSG "title.db copy failed"
cp -w "$[ID1DIR]/dbs/title.db" $[OUT]/sd/title.db
set ERRORMSG "import.db copy failed"
cp -w "$[ID1DIR]/dbs/import.db" $[OUT]/sd/import.db
set ERRORMSG "HOME Menu extdata copy failed"
cp "$[ID1DIR]/extdata/00000000/$[EXTID]" $[OUT]/sd/homemenu-extdata
echo "Exported.\nPower off from GodMode9.\n\n$[OUT]"
goto Menu

@Menu_Back

@Menu_Import
dirsel "Select one ci-manage export folder" 0:/gm9/out/ci-manage SNAP
set BAK $[GM9OUT]/ci-manage/backup-$[DATESTAMP]-$[TIMESTAMP]
echo "Snapshot:\n$[SNAP]\n\nLive files are copied to:\n$[BAK]\n\nThen NAND ticket.db, HOME Menu save, seed save, SD title databases, and HOME Menu extdata are replaced."
ask "Write this snapshot back?"
mkdir $[GM9OUT]/ci-manage
mkdir $[BAK]
mkdir $[BAK]/nand
mkdir $[BAK]/sd
echo "Backing up the live files"
cp -w 1:/dbs/ticket.db $[BAK]/nand/ticket.db
cp -w 1:/data/$[SYSID0]/sysdata/$[HMSAVE]/00000000 $[BAK]/nand/homemenu-save.bin
cp -w 1:/data/$[SYSID0]/sysdata/0001000f/00000000 $[BAK]/nand/seed-save.bin
find "0:/Nintendo 3DS/$[SYSID0]/*" ID1DIR
cp -w "$[ID1DIR]/dbs/title.db" $[BAK]/sd/title.db
cp -w "$[ID1DIR]/dbs/import.db" $[BAK]/sd/import.db
cp "$[ID1DIR]/extdata/00000000/$[EXTID]" $[BAK]/sd/homemenu-extdata
allow -a 1:/
echo "Writing the snapshot"
cp -w -n $[SNAP]/sd/title.db "$[ID1DIR]/dbs/title.db"
cp -w -n $[SNAP]/sd/import.db "$[ID1DIR]/dbs/import.db"
if find "$[SNAP]/nand/Launcher.dat" LAUNCHER
	imgmount "1:/data/$[SYSID0]/sysdata/$[HMSAVE]/00000000"
	cp -w -n $[LAUNCHER] G:/Launcher.dat
	imgumount
else
	cp -w -n $[SNAP]/nand/homemenu-save.bin "1:/data/$[SYSID0]/sysdata/$[HMSAVE]/00000000"
end
if find "$[SNAP]/nand/SEEDDB" SEEDDB
	imgmount "1:/data/$[SYSID0]/sysdata/0001000f/00000000"
	cp -w -n $[SEEDDB] G:/SEEDDB
	imgumount
else
	cp -w -n $[SNAP]/nand/seed-save.bin "1:/data/$[SYSID0]/sysdata/0001000f/00000000"
end
if find "$[SNAP]/nand/tickets/*" TICKETFOUND
	imgmount 1:/dbs/ticket.db
	for "$[SNAP]/nand/tickets/*" TICKET
		strsplit TICKETNAME $[TICKET] "/"
		cp -w -n $[TICKET] "G:/$[TICKETNAME]"
	next
	imgumount
else
	cp -w -n $[SNAP]/nand/ticket.db 1:/dbs/ticket.db
end
if find "$[SNAP]/nand/tickets-remove/*" REMOVED
	imgmount 1:/dbs/ticket.db
	for "$[SNAP]/nand/tickets-remove/*" TICKET
		strsplit TICKETNAME $[TICKET] "/"
		rm "G:/$[TICKETNAME]"
	next
	imgumount
end
set TMP $[GM9OUT]/ci-manage/tmp-extdata-$[TIMESTAMP]
set EXTDIR "$[ID1DIR]/extdata/00000000/$[EXTID]"
cp -w -n $[SNAP]/sd/homemenu-extdata $[TMP]
rm $[EXTDIR]
mv $[TMP] $[EXTDIR]
echo "Import finished.\nPower off from GodMode9, then boot the system.\nBackup:\n$[BAK]"
goto Menu
